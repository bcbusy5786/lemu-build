# See docs/devel/tracing.rst for syntax documentation.

# translate.c
mips_translate_c0(const char *instr, const char *rn, int reg, int sel) "%s %s (reg %d sel %d)"
mips_translate_tr(const char *instr, int rt, int u, int sel, int h) "%s (reg %d u %d sel %d h %d)"

# nt_idle.c
mips_nt_idle(int cpu, uint64_t pc) "cpu %d halts in the NT idle loop, resume at 0x%" PRIx64
mips_nt_idle_watch(int cpu, int idle, uint64_t next, uint64_t dpc) "cpu %d watches cpu %d: next thread 0x%" PRIx64 ", DPC list 0x%" PRIx64
mips_nt_idle_kick(int cpu, int idle) "cpu %d wakes cpu %d"
